---
// src/pages/404.astro – hibaoldal; GitHub Pages minden ismeretlen címre ezt adja, ezért kétnyelvű
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---
<Base locale="en" title="404 – LP Wave" noindex>
  <Nav locale="en" />
  <main class="container nf">
    <span class="label">404</span>
    <h1>Page not found.</h1>
    <p>The page you are looking for doesn’t exist or has moved.</p>
    <p lang="hu">A keresett oldal nem létezik vagy elköltözött.</p>
    <div class="links">
      <a class="cta" href="/">Home <span aria-hidden="true">→</span></a>
      <a class="alt" href="/hu/" lang="hu">Főoldal <span aria-hidden="true">→</span></a>
    </div>
  </main>
  <Footer locale="en" />
</Base>
<style>
  .nf { padding-block: clamp(4rem, 12vw, 9rem) var(--space-5); }
  h1 { font-size: clamp(2.6rem, 7vw, 5.5rem); font-weight: 800; margin: var(--space-2) 0 var(--space-3); }
  p { color: var(--text-2); font-size: 1.2rem; margin: 0 0 .4rem; max-width: 40ch; }
  .links { display: flex; gap: var(--space-3); align-items: center; flex-wrap: wrap; margin-top: var(--space-4); }
  .cta { display: inline-flex; gap: .6rem; align-items: center; background: var(--text); color: var(--bg); text-decoration: none; font-weight: 600; padding: .9rem 1.5rem; border-radius: 999px; transition: background 200ms; }
  .cta:hover { background: var(--accent); }
  .alt { font-weight: 600; text-decoration: none; border-bottom: 1.5px solid var(--accent); padding-bottom: 2px; }
</style>
